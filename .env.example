# Plantilla de variables de entorno de Recycle_AI.
#
# Copia este archivo a .env y rellena los valores:
#     copy .env.example .env      (PowerShell / CMD)
#     cp .env.example .env        (bash)
#
# El .env esta en .gitignore, asi que tu API key nunca se sube al repo.
# Esta plantilla si va versionada: no pongas secretos reales aqui.


# --- OBLIGATORIO -------------------------------------------------------------

# API key privada de Roboflow. La usa scripts/04_load_dataset.py para descargar
# el dataset.
#
# Donde sacarla:
#   1. Entra a https://app.roboflow.com
#   2. Icono de tu cuenta (arriba a la derecha) > Settings
#   3. En el menu lateral: API Keys  ->  copia la "Private API Key"
#
# Tambien aparece dentro del snippet de "Show download code" de la pagina del
# dataset, en la linea:   rf = Roboflow(api_key="aqui_va_la_key")
ROBOFLOW_API_KEY=pega_aqui_tu_private_api_key


# --- OPCIONAL ----------------------------------------------------------------

# Indice de la camara que usa scripts/03_test_camera.py.
# 0 = camara integrada de la laptop. Si tienes una webcam USB, prueba 1 o 2.
#CAMERA_INDEX=0
