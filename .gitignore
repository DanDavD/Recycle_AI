# Entorno virtual
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Datasets (se descargan con scripts/04_load_dataset.py, demasiado pesados para git)
datasets/**
!datasets/.gitkeep
!datasets/negatives/
!datasets/negatives/.gitkeep
!datasets/negatives/README.md
*.cache

# Pesos base descargados por ultralytics (yolov8n.pt si va versionado en el repo)
yolov8*.pt
yolo11*.pt
!yolov8n.pt

# Modelos entrenados (pesos pesados, no van en git)
models/*.pt
models/*.onnx
!models/.gitkeep

# Salidas de entrenamiento de YOLO
runs/

# Editor / SO
.vscode/
.idea/
Thumbs.db
.DS_Store

# Variables de entorno (la plantilla .env.example si va versionada)
.env
!.env.example
